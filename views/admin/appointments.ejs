<%- include('../partials/header', { title, active }) %>

<div class="page-head">
  <div>
    <h1>Appointments</h1>
    <p>Track and control every booking across the hospital.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/admin/appointments/new">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New appointment
    </a>
  </div>
</div>

<div class="card">
  <form class="filter-bar" method="GET" action="/admin/appointments">
    <div class="form-group">
      <label>Status</label>
      <select class="form-control" name="status">
        <option value="">All statuses</option>
        <% statuses.forEach(function(s){ %>
          <option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label>Date</label>
      <input class="form-control" type="date" name="date" value="<%= filters.date %>">
    </div>
    <div class="form-group" style="flex:1;min-width:200px">
      <label>Patient / doctor</label>
      <input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search names...">
    </div>
    <button class="btn btn-primary" type="submit">Apply filters</button>
    <a class="btn btn-outline" href="/admin/appointments">Reset</a>
  </form>

  <div class="card-body flush">
    <% if (appointments.length === 0) { %>
      <div class="empty-state">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <h3>No appointments found</h3>
        <p>Adjust the filters or create a new appointment.</p>
        <a class="btn btn-primary" href="/admin/appointments/new">Book an appointment</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr><th>#</th><th>Patient</th><th>Doctor</th><th>Department</th><th>Date</th><th>Slot</th><th>Status</th><th class="nowrap">Actions</th></tr>
          </thead>
          <tbody>
            <% appointments.forEach(function(a){ %>
              <tr>
                <td class="muted">#<%= a.id %></td>
                <td>
                  <div class="cell-name">
                    <span class="strong"><%= a.patient_name %></span>
                    <small><%= a.patient_phone || 'no phone' %></small>
                  </div>
                </td>
                <td class="strong"><%= a.doctor_name %></td>
                <td class="muted"><%= a.department_name || '—' %></td>
                <td class="nowrap"><%= formatDate(a.appointment_date) %></td>
                <td class="nowrap"><%= timeLabel(a.time_slot) %></td>
                <td><span class="badge <%= statusBadge(a.status) %>"><%= a.status %></span></td>
                <td>
                  <div class="row-actions">
                    <a class="btn btn-outline btn-sm" href="/admin/appointments/<%= a.id %>">Manage</a>
                    <form action="/admin/appointments/<%= a.id %>?_method=DELETE" method="POST" class="inline-form"
                          data-confirm="Delete appointment #<%= a.id %>?">
                      <button class="btn btn-danger btn-sm" type="submit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
