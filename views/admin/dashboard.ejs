<%- include('../partials/header', { title, active }) %>

<div class="page-head">
  <div>
    <h1>Hospital overview</h1>
    <p>Welcome back, <%= currentUser.name %>. Here is what is happening across MediCare today.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-outline" href="/admin/appointments/new">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Walk-in appointment
    </a>
    <a class="btn btn-primary" href="/admin/appointments">Manage appointments</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-icon blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div>
      <div class="stat-value"><%= stats.patients %></div>
      <div class="stat-label">Registered patients</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon teal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
    </div>
    <div>
      <div class="stat-value"><%= stats.doctors %></div>
      <div class="stat-label">Doctors on panel</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon violet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
    </div>
    <div>
      <div class="stat-value"><%= stats.appointments %></div>
      <div class="stat-label">Total appointments</div>
      <div class="stat-sub"><%= stats.today %> today · <%= stats.pending %> pending</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon green">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
    <div>
      <div class="stat-value"><%= inr(stats.revenue) %></div>
      <div class="stat-label">Revenue collected</div>
      <div class="stat-sub text-danger fw-bold"><%= stats.unpaidBills %> unpaid bill(s)</div>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div>
        <h2>Appointments by status</h2>
        <p>Distribution across the full booking workflow</p>
      </div>
    </div>
    <div class="card-body">
      <% const maxStatus = Math.max(1, ...statusBreakup.map(s => s.total)); %>
      <% ['pending','confirmed','completed','cancelled'].forEach(function(st){
           const row = statusBreakup.find(s => s.status === st);
           const total = row ? row.total : 0; %>
        <div class="bar-row">
          <span class="bar-label"><%= st %></span>
          <div class="bar-track"><div class="bar-fill" style="width:<%= (total/maxStatus*100).toFixed(1) %>%"></div></div>
          <span class="bar-value"><%= total %></span>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h2>Doctors per department</h2>
        <p>Staffing across specialties</p>
      </div>
      <a class="btn btn-ghost btn-sm" href="/admin/departments">Manage</a>
    </div>
    <div class="card-body">
      <% const maxDept = Math.max(1, ...deptBreakup.map(d => d.doctors)); %>
      <% deptBreakup.forEach(function(d){ %>
        <div class="bar-row">
          <span class="bar-label"><%= d.name %></span>
          <div class="bar-track"><div class="bar-fill" style="width:<%= (d.doctors/maxDept*100).toFixed(1) %>%"></div></div>
          <span class="bar-value"><%= d.doctors %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header">
    <div>
      <h2>Today's schedule</h2>
      <p>Appointments booked for <%= formatDate(new Date().toISOString().slice(0,10)) %></p>
    </div>
    <a class="btn btn-ghost btn-sm" href="/admin/appointments?date=<%= new Date().toISOString().slice(0,10) %>">View all</a>
  </div>
  <div class="card-body flush">
    <% if (todayAppointments.length === 0) { %>
      <div class="empty-state">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <h3>No appointments today</h3>
        <p>New bookings will appear here as patients schedule visits.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Reason</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            <% todayAppointments.forEach(function(a){ %>
              <tr>
                <td class="fw-bold nowrap"><%= timeLabel(a.time_slot) %></td>
                <td><%= a.patient_name %></td>
                <td class="muted"><%= a.doctor_name %></td>
                <td class="muted"><%= a.reason || '—' %></td>
                <td><span class="badge <%= statusBadge(a.status) %>"><%= a.status %></span></td>
                <td><a class="btn btn-outline btn-sm" href="/admin/appointments/<%= a.id %>">Open</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header">
    <div>
      <h2>Recent appointments</h2>
      <p>Latest booking activity in the hospital</p>
    </div>
  </div>
  <div class="card-body flush">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr><th>#</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Slot</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% recentAppointments.forEach(function(a){ %>
            <tr>
              <td class="muted">#<%= a.id %></td>
              <td class="strong"><%= a.patient_name %></td>
              <td class="muted"><%= a.doctor_name %></td>
              <td class="nowrap"><%= formatDate(a.appointment_date) %></td>
              <td class="nowrap"><%= timeLabel(a.time_slot) %></td>
              <td><span class="badge <%= statusBadge(a.status) %>"><%= a.status %></span></td>
              <td><a class="btn btn-outline btn-sm" href="/admin/appointments/<%= a.id %>">Open</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
