<%- include('../partials/header', { title, active }) %>

<div class="page-head">
  <div>
    <h1>New walk-in appointment</h1>
    <p>Book an appointment on behalf of a registered patient.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-outline" href="/admin/appointments">Back to appointments</a>
  </div>
</div>

<div class="card" style="max-width:780px">
  <div class="card-body">
    <form action="/admin/appointments" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label>Patient <span class="req">*</span></label>
          <select class="form-control" name="patient_id" required>
            <option value="">Select patient...</option>
            <% patients.forEach(function(p){ %>
              <option value="<%= p.id %>" <%= String(form.patient_id||'')===String(p.id)?'selected':'' %>><%= p.name %> (<%= p.email %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Doctor <span class="req">*</span></label>
          <select class="form-control" name="doctor_id" required data-availability="doctor">
            <option value="">Select doctor...</option>
            <% doctors.forEach(function(doc){ %>
              <option value="<%= doc.id %>" <%= String(form.doctor_id||'')===String(doc.id)?'selected':'' %>>
                <%= doc.name %> — <%= doc.department_name || 'General' %> (<%= inr(doc.fee) %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Date <span class="req">*</span></label>
          <input class="form-control" type="date" name="appointment_date" min="<%= new Date().toISOString().slice(0,10) %>"
                 data-availability="date" value="<%= form.appointment_date || '' %>" required>
        </div>
        <div class="form-group">
          <label>Time slot <span class="req">*</span></label>
          <select class="form-control" name="time_slot" required data-availability="slot">
            <option value="">Pick a slot...</option>
            <% timeSlots.forEach(function(slot){ %>
              <option value="<%= slot %>" <%= form.time_slot===slot?'selected':'' %>><%= timeLabel(slot) %></option>
            <% }) %>
          </select>
          <span class="field-hint" data-availability="hint">Choose a doctor and date to see live availability.</span>
        </div>
        <div class="form-group span-2">
          <label>Reason / symptoms</label>
          <textarea class="form-control" name="reason" placeholder="Brief reason for the visit"><%= form.reason || '' %></textarea>
        </div>
      </div>
      <div class="mt-3" style="display:flex;gap:10px">
        <button class="btn btn-primary" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Book appointment
        </button>
        <a class="btn btn-outline" href="/admin/appointments">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
