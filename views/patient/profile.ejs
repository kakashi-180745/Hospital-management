<%- include('../partials/header', { title, active }) %>

<div class="page-head">
  <div>
    <h1>My profile</h1>
    <p>Keep your personal and medical details up to date.</p>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h2>Personal information</h2></div>
    <div class="card-body">
      <form action="/patient/profile?_method=PUT" method="POST" novalidate>
        <div class="stack">
          <div class="form-group">
            <label>Full name <span class="req">*</span></label>
            <input class="form-control <%= errors.name?'is-invalid':'' %>" name="name" required value="<%= patient.name %>">
            <% if (errors.name) { %><span class="field-error"><%= errors.name %></span><% } %>
          </div>
          <div class="form-group">
            <label>Email address</label>
            <input class="form-control" value="<%= patient.email %>" disabled>
            <span class="field-hint">Email cannot be changed.</span>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label>Phone</label>
              <input class="form-control <%= errors.phone?'is-invalid':'' %>" name="phone" maxlength="10" value="<%= patient.phone || '' %>" placeholder="10-digit mobile">
              <% if (errors.phone) { %><span class="field-error"><%= errors.phone %></span><% } %>
            </div>
            <div class="form-group">
              <label>Gender</label>
              <select class="form-control" name="gender">
                <option value="">Prefer not to say</option>
                <% genders.forEach(function(g){ %>
                  <option value="<%= g %>" <%= patient.gender===g?'selected':'' %>><%= g %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>Date of birth</label>
              <input class="form-control <%= errors.dob?'is-invalid':'' %>" type="date" name="dob"
                     max="<%= new Date().toISOString().slice(0,10) %>" value="<%= patient.dob || '' %>">
              <% if (errors.dob) { %><span class="field-error"><%= errors.dob %></span><% } %>
            </div>
            <div class="form-group">
              <label>Blood group</label>
              <select class="form-control" name="blood_group">
                <option value="">Not sure</option>
                <% bloodGroups.forEach(function(bg){ %>
                  <option value="<%= bg %>" <%= patient.blood_group===bg?'selected':'' %>><%= bg %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Address</label>
            <textarea class="form-control" name="address"><%= patient.address || '' %></textarea>
          </div>
          <button class="btn btn-primary" type="submit">Save changes</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Security</h2></div>
    <div class="card-body">
      <form action="/patient/profile/password" method="POST" class="stack">
        <div class="form-group">
          <label>Current password <span class="req">*</span></label>
          <input class="form-control" type="password" name="current_password" required>
        </div>
        <div class="form-group">
          <label>New password <span class="req">*</span></label>
          <input class="form-control" type="password" name="new_password" required minlength="6" placeholder="Min. 6 characters">
        </div>
        <div class="form-group">
          <label>Confirm new password <span class="req">*</span></label>
          <input class="form-control" type="password" name="confirm_password" required>
        </div>
        <button class="btn btn-outline" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Update password
        </button>
      </form>

      <hr style="border:none;border-top:1px solid var(--line);margin:26px 0">

      <div class="detail-grid">
        <div class="detail-item"><div class="dt">Patient ID</div><div class="dd">#<%= patient.id %></div></div>
        <div class="detail-item"><div class="dt">Member since</div><div class="dd"><%= formatDate(patient.created_at.slice(0,10)) %></div></div>
      </div>

      <form action="/logout" method="POST" class="mt-3">
        <button class="btn btn-danger btn-block" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Log out from all devices
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
