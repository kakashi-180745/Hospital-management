<%- include('../partials/header', { title, active: 'book' }) %>

<div class="page-head">
  <div>
    <h1>Book an appointment</h1>
    <p>Pick a specialist, choose a date and select from live available slots.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-outline" href="/patient/appointments">My appointments</a>
  </div>
</div>

<div class="grid-2" style="grid-template-columns:1.4fr .9fr">
  <div class="card">
    <div class="card-header"><h2>Appointment details</h2></div>
    <div class="card-body">
      <form action="/patient/appointments" method="POST" novalidate>
        <div class="stack">
          <div class="form-group">
            <label>Doctor <span class="req">*</span></label>
            <select class="form-control <%= errors.doctor_id?'is-invalid':'' %>" name="doctor_id" required data-availability="doctor">
              <option value="">Select a doctor...</option>
              <% doctors.forEach(function(doc){ %>
                <option value="<%= doc.id %>" <%= String(form.doctor_id||'')===String(doc.id)?'selected':'' %>>
                  <%= doc.name %> — <%= doc.department_name || 'General' %> · <%= inr(doc.fee) %>
                </option>
              <% }) %>
            </select>
            <% if (errors.doctor_id) { %><span class="field-error"><%= errors.doctor_id %></span><% } %>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Preferred date <span class="req">*</span></label>
              <input class="form-control <%= errors.appointment_date?'is-invalid':'' %>" type="date"
                     name="appointment_date" min="<%= today %>" data-availability="date"
                     value="<%= form.appointment_date || '' %>" required>
              <% if (errors.appointment_date) { %><span class="field-error"><%= errors.appointment_date %></span><% } %>
            </div>
            <div class="form-group">
              <label>Time slot <span class="req">*</span></label>
              <select class="form-control <%= errors.time_slot?'is-invalid':'' %>" name="time_slot" required data-availability="slot">
                <option value="">Pick a slot...</option>
                <% timeSlots.forEach(function(slot){ %>
                  <option value="<%= slot %>" <%= form.time_slot===slot?'selected':'' %>><%= timeLabel(slot) %></option>
                <% }) %>
              </select>
              <% if (errors.time_slot) { %><span class="field-error"><%= errors.time_slot %></span><% } %>
              <span class="field-hint" data-availability="hint">Choose a doctor and date to see live availability.</span>
            </div>
          </div>

          <div class="form-group">
            <label>Reason / symptoms</label>
            <textarea class="form-control" name="reason" placeholder="Briefly describe what you are consulting for"><%= form.reason || '' %></textarea>
          </div>

          <button class="btn btn-primary" type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
            Confirm booking
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Available specialists</h2></div>
    <div class="card-body flush">
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>Doctor</th><th>Department</th><th>Fee</th></tr></thead>
          <tbody>
            <% doctors.forEach(function(doc){ %>
              <tr>
                <td>
                  <div class="cell-name">
                    <span class="strong"><%= doc.name %></span>
                    <small><%= doc.specialization || '' %></small>
                  </div>
                </td>
                <td class="muted"><%= doc.department_name || '—' %></td>
                <td class="fw-bold nowrap"><%= inr(doc.fee) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
