<%- include('../partials/header', { title, active }) %>

<div class="page-head">
  <div>
    <h1>Hello, <%= currentUser.name.split(' ')[0] %> 👋</h1>
    <p>Here is a summary of your healthcare journey at MediCare Hospital.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/patient/appointments/book">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Book appointment
    </a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-icon blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    </div>
    <div><div class="stat-value"><%= stats.upcoming %></div><div class="stat-label">Upcoming visits</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon green">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <div><div class="stat-value"><%= stats.completed %></div><div class="stat-label">Visits completed</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon teal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5 3.5 13.5a5 5 0 0 1 7-7l7 7a5 5 0 0 1-7 7Z"/><path d="m8.5 8.5 7 7"/></svg>
    </div>
    <div><div class="stat-value"><%= stats.prescriptions %></div><div class="stat-label">Prescriptions</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon <%= stats.due > 0 ? 'red' : 'violet' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
    </div>
    <div><div class="stat-value"><%= inr(stats.due) %></div><div class="stat-label">Outstanding dues</div></div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div><h2>Upcoming appointments</h2><p>Your next scheduled visits</p></div>
      <a class="btn btn-ghost btn-sm" href="/patient/appointments">View all</a>
    </div>
    <div class="card-body flush">
      <% if (upcoming.length === 0) { %>
        <div class="empty-state">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          </div>
          <h3>No upcoming visits</h3>
          <p>Book an appointment with one of our specialists.</p>
          <a class="btn btn-primary" href="/patient/appointments/book">Book now</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table">
            <thead><tr><th>Date</th><th>Doctor</th><th>Status</th></tr></thead>
            <tbody>
              <% upcoming.forEach(function(a){ %>
                <tr>
                  <td class="nowrap"><strong><%= formatDate(a.appointment_date) %></strong><br><small class="text-muted"><%= timeLabel(a.time_slot) %></small></td>
                  <td>
                    <div class="cell-name">
                      <span class="strong"><%= a.doctor_name %></span>
                      <small><%= a.department_name || '' %></small>
                    </div>
                  </td>
                  <td><span class="badge <%= statusBadge(a.status) %>"><%= a.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div><h2>Latest prescriptions</h2><p>Recently issued medical advice</p></div>
      <a class="btn btn-ghost btn-sm" href="/patient/prescriptions">View all</a>
    </div>
    <div class="card-body">
      <% if (recentRx.length === 0) { %>
        <div class="empty-state" style="padding:26px 10px">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5 3.5 13.5a5 5 0 0 1 7-7l7 7a5 5 0 0 1-7 7Z"/><path d="m8.5 8.5 7 7"/></svg>
          </div>
          <h3>No prescriptions yet</h3>
          <p>They will appear here after a completed visit.</p>
        </div>
      <% } else { %>
        <div class="stack">
          <% recentRx.forEach(function(rx){ %>
            <div style="border:1px solid var(--line);border-left:4px solid var(--primary);border-radius:11px;padding:14px 16px">
              <div class="flex-between">
                <strong><%= rx.diagnosis %></strong>
                <span class="fs-sm text-muted"><%= formatDate(rx.created_at.slice(0,10)) %></span>
              </div>
              <p class="fs-sm text-muted mt-2"><%= rx.doctor_name || 'Doctor' %></p>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% if (unpaidBills.length) { %>
  <div class="card mt-3" style="border-left:4px solid var(--danger)">
    <div class="card-header">
      <div><h2>Pending bills</h2><p>Settle these at your convenience from the billing section.</p></div>
      <a class="btn btn-primary btn-sm" href="/patient/bills">Pay bills</a>
    </div>
    <div class="card-body flush">
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>Bill #</th><th>Description</th><th>Amount</th><th>Issued</th></tr></thead>
          <tbody>
            <% unpaidBills.forEach(function(b){ %>
              <tr>
                <td class="muted">#<%= b.id %></td>
                <td><%= b.description %></td>
                <td class="fw-bold text-danger"><%= inr(b.amount) %></td>
                <td class="muted nowrap"><%= formatDate(b.created_at.slice(0,10)) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
