<header class="topbar">
  <button class="icon-btn menu-toggle" id="menuToggle" aria-label="Toggle menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div class="topbar-title"><%= title %></div>
  <div class="topbar-spacer"></div>
  <div class="user-chip">
    <div class="avatar"><%= currentUser.name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase() %></div>
    <div class="user-meta">
      <div class="name"><%= currentUser.name %></div>
      <div class="role"><%= currentUser.role %></div>
    </div>
  </div>
  <form action="/logout" method="POST" class="inline-form">
    <button class="icon-btn" type="submit" title="Log out" aria-label="Log out">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </button>
  </form>
</header>
