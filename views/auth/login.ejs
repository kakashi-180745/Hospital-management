<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login · MediCare HMS</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%230d9488'%3E%3Cpath d='M19 8h-2V3H7v5H5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-9c0-1.1-.9-2-2-2zm-6 9h-2v-3H8v-2h3V9h2v3h3v2h-3v3z'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-wrapper">
  <%- include('../partials/auth-aside') %>

  <main class="auth-main">
    <div class="auth-card">
      <div class="auth-logo-row">
        <div class="brand-logo">
          <svg viewBox="0 0 24 24" fill="#fff"><path d="M19 8h-2V3H7v5H5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-9c0-1.1-.9-2-2-2zm-6 9h-2v-3H8v-2h3V9h2v3h3v2h-3v3z"/></svg>
        </div>
        <div class="brand-name" style="color:var(--ink)">MediCare HMS</div>
      </div>

      <h1>Welcome back</h1>
      <p class="subtitle">Sign in to the <strong><%= role === 'admin' ? 'Administrator' : 'Patient' %></strong> portal to continue.</p>

      <div class="role-tabs">
        <a class="role-tab <%= role==='patient'?'active':'' %>" href="/login?role=patient">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Patient
        </a>
        <a class="role-tab <%= role==='admin'?'active':'' %>" href="/login?role=admin">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Admin
        </a>
      </div>

      <%- include('../partials/flash') %>

      <form class="auth-form" action="/login" method="POST" novalidate>
        <input type="hidden" name="role" value="<%= role %>">
        <div class="form-group">
          <label for="email">Email address</label>
          <div class="input-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <input class="form-control <%= errors.email?'is-invalid':'' %>" type="email" id="email" name="email"
                   value="<%= email %>" placeholder="you@example.com" autofocus required>
          </div>
          <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input class="form-control <%= errors.password?'is-invalid':'' %>" type="password" id="password"
                   name="password" placeholder="Enter your password" required>
          </div>
          <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
        </div>

        <button class="btn btn-primary btn-block" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Sign in as <%= role === 'admin' ? 'Admin' : 'Patient' %>
        </button>
      </form>

      <% if (role === 'patient') { %>
        <p class="auth-alt">New to MediCare? <a href="/register"><strong>Create a patient account</strong></a></p>
      <% } else { %>
        <p class="auth-alt">Looking for patient access? <a href="/login?role=patient"><strong>Go to patient login</strong></a></p>
      <% } %>

      <div class="demo-hint">
        <strong>Demo credentials</strong>
        <% if (role === 'admin') { %>
          Admin — email: <code>admin@hospital.com</code> &nbsp;password: <code>admin123</code>
        <% } else { %>
          Patient — email: <code>patient@demo.com</code> &nbsp;password: <code>patient123</code>
        <% } %>
      </div>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
</body>
</html>
